# Postgres-anslutning, t.ex. lokal Postgres, Neon eller Supabase
DATABASE_URL="postgresql://user:password@localhost:5432/skeningevvs_loggen"

# Slumpad hemlig nyckel, minst 32 tecken. Generera t.ex. med:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""

# URL:en appen körs på
BETTER_AUTH_URL="http://localhost:3000"

# UploadThing-token för bilduppladdning (jobbilder + företagslogotyp)
# Skapa på https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=""

# Valfri. Skyddar /api/cron/stada-uppladdningar (Vercel Cron skickar den
# som "Authorization: Bearer ..."). Utan den städas osparade bilder inte bort.
CRON_SECRET=""
