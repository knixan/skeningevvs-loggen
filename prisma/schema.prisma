// ============================================================
// Skeningevvs-loggen – Prisma Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// AUTH – better-auth hanterar dessa tabeller
// ============================================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts Account[]
  sessions Session[]
  company  Company?

  @@map("user")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ============================================================
// FÖRETAG, KUNDER & JOBB
// ============================================================

model Company {
  id        String   @id @default(cuid())
  name      String
  ownerId   String   @unique
  createdAt DateTime @default(now())

  // Företagsuppgifter
  orgNummer  String  @default("")
  adress     String  @default("")
  postnummer String  @default("")
  ort        String  @default("")
  telefon    String  @default("")
  epost      String  @default("")
  fSkatt     Boolean @default(false)
  momsNummer String  @default("")
  bankgiro   String  @default("")
  plusgiro   String  @default("")
  swish      String  @default("")
  logoUrl    String  @default("")
  logoKey    String  @default("")

  // Fakturainställningar
  nastaFakturanummer Int    @default(1)
  forfallodagar      Int    @default(30)
  drojsmalsranta     Float  @default(0)
  fakturatext        String @default("")

  // Offerter har en egen nummerserie, skild från fakturanumren
  nastaOffertnummer Int @default(1)

  // Ahlsell-prislista. Bara artiklar med ahlsellImportId lika med det här
  // fältet är aktiva – en inläsning som avbryts halvvägs syns alltså aldrig.
  ahlsellImportId       String?
  ahlsellImporteradVid  DateTime?
  ahlsellAntalArtiklar  Int       @default(0)
  ahlsellAvtalInlast    Boolean   @default(false)
  // Avtalets slutdatum som det står i avtalsfilen (ÅÅMMDD), tomt om okänt
  ahlsellAvtalSlutdatum String    @default("")
  // Påslag i procent som föreslås som utpris när en Ahlsell-artikel väljs
  materialPaslag        Float     @default(0)

  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  jobs            Job[]
  customers       Customer[]
  fakturor        Faktura[]
  offerter        Offert[]
  ahlsellArtiklar AhlsellArtikel[]

  @@map("company")
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  typ       String   @default("privat") // "privat" | "foretag"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Gemensamma fält
  namn       String
  adress     String @default("")
  postnummer String @default("")
  ort        String @default("")
  telefon    String @default("")
  epost      String @default("")

  // Privatperson
  personnummer String @default("")

  // Företagskund
  foretagsnamn  String @default("")
  kontaktperson String @default("")
  orgNummer     String @default("")

  // ROT-specifikt
  fastighetsbeteckning String @default("")
  lagenhetsnummer      String @default("")
  bostadsrattsforening String @default("")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs     Job[]
  fakturor Faktura[]
  offerter Offert[]

  @@index([companyId])
  @@map("customer")
}

model Job {
  id         String  @id @default(cuid())
  companyId  String
  customerId String?

  // Status
  rotAvdrag  Boolean @default(false)
  pagaende   Boolean @default(false)
  utfort     Boolean @default(false)
  fakturerat Boolean @default(false)
  betalt     Boolean @default(false)

  // Uppföljning – oberoende av status ovan
  foljUpp      Boolean   @default(false)
  foljUppDatum DateTime? @db.Date

  // Fakturering. Själva fakturan sparas i `faktura` när den utfärdas.
  fakturanummer Int?

  // Prissättning
  timpris        Float  @default(0)
  milersattning  Float  @default(0)
  fastPris       Float?
  // Hur mycket av fastPris som är arbete (exkl. moms) – ROT räknas på den
  fastPrisArbete Float?

  // Anteckningar
  anteckningar        String @default("")
  utfortArbete        String @default("")
  planeratArbete      String @default("")
  // Visas aldrig för kunden (varken på faktura eller utskrift)
  internaAnteckningar String @default("")

  // Tidsstämplar
  skapad    DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationer
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  artiklar        Article[]
  resor           Trip[]
  arbetspass      WorkSession[]
  images          JobImage[]
  ovrigaKostnader OvrigKostnad[]
  faktura         Faktura?
  // Offerten som jobbet skapades från ("Gör om till jobb")
  offert          Offert?

  // Ett fakturanummer kan aldrig delas ut två gånger (PostgreSQL tillåter
  // flera NULL, alltså flera jobb utan faktura)
  @@unique([companyId, fakturanummer])
  @@index([companyId])
  @@index([customerId])
  @@index([companyId, fakturerat])
  @@index([companyId, betalt])
  @@map("job")
}

// En utfärdad faktura, sparad precis som den såg ut när den utfärdades.
// Utskrift och PDF läser härifrån, så ändringar i jobbet, kunden eller
// företaget efteråt påverkar inte fakturan (bokföringslagen). Skrivs bara av
// utfardaFaktura och ändras aldrig.
model Faktura {
  id            String   @id @default(cuid())
  companyId     String
  // Tas jobbet eller kunden bort finns fakturan kvar (SetNull)
  jobId         String?  @unique
  customerId    String?
  fakturanummer Int
  fakturadatum  DateTime @db.Date
  forfallodatum DateTime @db.Date
  utfardad      DateTime @default(now())

  // Summorna i ören (heltal), så att statistik kan summera exakt i databasen
  exklMomsOre  Int
  momsOre      Int
  rotAvdragOre Int
  attBetalaOre Int

  // Allt som står på fakturan – FakturaData i lib/faktura.ts
  innehall Json

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job      Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([companyId, fakturanummer])
  @@index([companyId, fakturadatum])
  @@index([customerId])
  @@map("faktura")
}

// En offert till en kund, innan jobbet är beställt. Egen modell, så att
// offerter aldrig blandas ihop med jobb och fakturor. Offerten kan ändras
// fritt – den är inget bokföringsunderlag. Beloppen räknas med samma
// beräkning som fakturan (offertPrisunderlag + beräknaFaktura).
model Offert {
  id           String  @id @default(cuid())
  companyId    String
  customerId   String?
  // Jobbet som skapades när kunden tackade ja. Tas jobbet bort finns
  // offerten kvar (SetNull) och kan göras om till jobb igen.
  jobId        String? @unique
  // Delas ut från company.nastaOffertnummer när offerten skapas
  offertnummer Int
  status       String  @default("utkast") // "utkast" | "skickad" | "accepterad" | "avbojd"

  offertdatum DateTime @db.Date
  giltigTill  DateTime @db.Date

  rotAvdrag       Boolean @default(false)
  timpris         Float   @default(0)
  milersattning   Float   @default(0)
  // Uppskattningar för priset – inte loggad tid eller körda mil
  beraknadeTimmar Float   @default(0)
  beraknadStracka Float   @default(0)
  fastPris        Float?
  // Hur mycket av fastPris som är arbete (exkl. moms) – ROT räknas på den
  fastPrisArbete  Float?

  // Visas för kunden
  beskrivning         String @default("")
  villkor             String @default("")
  // Visas aldrig för kunden
  internaAnteckningar String @default("")

  skapad    DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  job             Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  artiklar        OffertArtikel[]
  ovrigaKostnader OffertKostnad[]

  @@unique([companyId, offertnummer])
  @@index([companyId])
  @@index([customerId])
  @@map("offert")
}

// Raderna byts ut i sin helhet när offerten sparas. `ordning` håller dem i
// den ordning de skrevs in – utan ORDER BY lovar databasen ingen ordning.
model OffertArtikel {
  id       String @id @default(cuid())
  offertId String
  ordning  Int    @default(0)

  namn           String
  artikelnr      String @default("")
  aterforsaljare String @default("")
  inkopspris     Float  @default(0)
  pris           Float
  antal          Float  @default(1)
  enhet          String @default("")

  offert Offert @relation(fields: [offertId], references: [id], onDelete: Cascade)

  @@index([offertId])
  @@map("offert_artikel")
}

model OffertKostnad {
  id       String @id @default(cuid())
  offertId String
  ordning  Int    @default(0)

  beskrivning String
  pris        Float  @default(0)

  offert Offert @relation(fields: [offertId], references: [id], onDelete: Cascade)

  @@index([offertId])
  @@map("offert_kostnad")
}

model Article {
  id    String @id @default(cuid())
  jobId String

  namn           String
  artikelnr      String @default("")
  aterforsaljare String @default("")
  inkopspris     Float  @default(0)
  pris           Float
  // Decimaltal – rör och kabel köps per meter
  antal          Float  @default(1)
  // ST, M, KG … tomt = styck
  enhet          String @default("")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("article")
}

// En rad ur Ahlsells prislista (beräkningsgrund + kundavtal), se lib/ahlsell.ts.
// Priser i ören för att slippa avrundningsfel.
model AhlsellArtikel {
  id        String @id @default(cuid())
  companyId String
  importId  String

  artikelnr            String
  benamning            String
  enhet                String  @default("")
  materialklass        String  @default("")
  lagerford            Boolean @default(false)
  // Antal som måste beställas åt gången (1 = valfritt antal)
  bestallningsmultipel Float   @default(1)
  // Grundnettopris före kundens rabatter. 0 = pris på begäran.
  grundprisOre         Int
  // Kundens pris enligt avtalsfilen (= grundpris om ingen avtalsfil lästs in)
  nettoprisOre         Int

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, importId])
  @@map("ahlsell_artikel")
}

model Trip {
  id    String @id @default(cuid())
  jobId String

  datum   DateTime @db.Date
  stracka Float    @default(0)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("trip")
}

model WorkSession {
  id    String @id @default(cuid())
  jobId String

  datum  DateTime @db.Date
  timmar Float

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("work_session")
}

model JobImage {
  id        String   @id @default(cuid())
  jobId     String
  url       String
  key       String
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_image")
}

model OvrigKostnad {
  id    String @id @default(cuid())
  jobId String

  beskrivning String
  pris        Float  @default(0)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("ovrig_kostnad")
}
